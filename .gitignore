# Repository-wide generated and private inputs.
#
# Machine-specific files belong in `.git/info/exclude`.
/build/
/build-*/
/cmake-build-*/
/dist/
/debug/

# User-supplied retail game files. Commit descriptors and hashes, never binaries.
/assets/

# Local matching experiments and caches.
/.cache/
# The Windows matching toolchain, built on each machine by tools/matching/windows/build-toolchain.sh.
/externals/old-gcc/prebuilt/windows-i386/
/externals/psx-binutils/prebuilt/windows-i386/

# Runtime state.
/memcards/
/logs/
# CTR Launcher settings when it runs from a checkout.
/ctr_native.ini
/launcher.ini
*.log

# Compiler outputs.
*.exe
*.o
*.gch
*.a
*.obj
*.pdb
*.ilk
*.d
*.depend
*.map
compile_commands.json

# Language and editor state.
.venv/
__pycache__/
*.py[cod]
.vs/
.idea/
*.swp
*~
