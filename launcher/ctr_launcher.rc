// Resources for MinGW builds (windres). MSVC builds take ctr_launcher.manifest directly.
#include <winresrc.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "ctr_launcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "CTR Launcher"
      VALUE "ProductName", "CTR Native"
      VALUE "FileVersion", "1.0.0"
      VALUE "OriginalFilename", "CTR Launcher.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
