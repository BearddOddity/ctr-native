{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CTR Launcher",
  "version": "1.0.0",
  "identifier": "dev.ctr-native.launcher",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CTR Launcher",
        "width": 1120,
        "height": 700,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "backgroundColor": "#060a2c",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Drop your own CTR disc, press Play",
    "copyright": "CTR Native contributors, GPL-3.0",
    "category": "Game"
  }
}
